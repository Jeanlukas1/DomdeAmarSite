  "narrative": {
    "northStar": "O Selo da Graça",
    "overview": "Tudo gira em torno do selo: o círculo branco com borda vermelha, o coração pintado em duas pinceladas e \"Dom de Amar\" escrito à mão. O site se comporta como um convite impresso e uma carta de amor, não como um portal corporativo. As formas recorrentes vêm do próprio selo: o círculo, a pincelada vermelha e o mini-coração entre dois traços. Elas funcionam como assinatura e pontuação, nunca como enfeite solto. O ritmo alterna faixas escuras e quentes, onde o selo brilha como uma brasa, com páginas creme serenas. O movimento é parte da identidade, mas tudo funciona estático com prefers-reduced-motion.",
    "keyCharacteristics": [
      "Selo do coração como assinatura e elemento de transição (hero → ícone do header).",
      "Alternância entre faixas escuras vinho e superfícies creme.",
      "Vermelho da Graça reservado para ação e emoção.",
      "Serifada display calorosa + sans legível + eyebrow em caixa alta espaçada.",
      "Formas macias: pílulas, cartões arredondados, sombras quentes e difusas.",
      "Fotos reais da comunidade. Nenhuma imagem genérica."
    ],
    "rules": [
      {
        "name": "The Ember Rule",
        "section": "colors",
        "body": "O vermelho da Graça aparece como ponto de calor: CTA, pincelada, coração. Uma seção clara nunca é \"pintada\" de vermelho. Superfícies fortes usam o vinho, e o vermelho fica para o que pede ação."
      },
      {
        "name": "The Warm Paper Rule",
        "section": "colors",
        "body": "Neutros são sempre quentes (creme, areia, tinta levemente avermelhada). Cinzas frios e azulados não entram."
      },
      {
        "name": "The Arc Echo Rule",
        "section": "typography",
        "body": "Toda seção abre com um eyebrow em caixa alta espaçada, seguido do título serifado. É a mesma voz do \"IGREJA EVANGÉLICA\" sobre o coração."
      },
      {
        "name": "The Script Stays Home Rule",
        "section": "typography",
        "body": "A letra cursiva pertence ao selo. Títulos, botões e navegação nunca usam fonte script."
      },
      {
        "name": "The One Glow Rule",
        "section": "elevation",
        "body": "Só o selo brilha. Botões, cartões e textos não ganham halo colorido; a luz é da marca, não da interface."
      },
      {
        "name": "The Warm Shadow Rule",
        "section": "elevation",
        "body": "Sombras levam a cor da marca (vinho ou vermelho) em baixa opacidade. Sombra cinza neutra não entra."
      }
    ],
    "dos": [
      "Do abrir cada seção com eyebrow + título serifado (The Arc Echo Rule).",
      "Do usar o selo, o círculo, a pincelada e o mini-coração entre traços como assinatura e pontuação.",
      "Do alternar faixas escuras vinho com superfícies creme para dar ritmo.",
      "Do usar sombras quentes e tingidas e cantos macios (pílulas, lg/xl).",
      "Do usar fotos reais da igreja, com recorte pensado para fotos verticais de celular.",
      "Do garantir contraste AA: vermelho em texto pequeno usa graca-red-deep."
    ],
    "donts": [
      "Don't pintar seções claras inteiras de vermelho. Superfície forte é vinho (The Ember Rule).",
      "Don't usar fonte cursiva fora do selo (The Script Stays Home Rule).",
      "Don't usar cinzas frios, sombras cinza puro ou fundo de página branco puro.",
      "Don't usar a chama branca da arte de horários. A marca é o selo do coração.",
      "Don't usar imagens de banco genéricas."
    ]
  }
}
