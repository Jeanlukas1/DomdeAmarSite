---
// Página 404: no clima do hero (escuro, selo pequeno), com caminho de volta.
import logoUrl from '@/assets/logo/logo.svg?url';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPrincipal } from '@/lib/igreja';

const ui = await getPrincipal('ui');
const t = ui.naoEncontrada;
---

<BaseLayout title={t.titulo}>
  <div class="superficie-escura grid min-h-[100svh] place-items-center bg-night px-4 py-20 text-center text-cream">
    <div class="max-w-xl">
      <img src={logoUrl} alt="" width="120" height="120" class="mx-auto size-28 rounded-full" />
      <h1 class="mt-10 text-[clamp(2.2rem,6vw,3.6rem)] font-medium tracking-[-0.02em]">
        {t.titulo}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-blush-100/85">{t.texto}</p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href="/">
          {t.voltar}
          <Icon name="arrow" class="transition-transform duration-base group-hover:translate-x-1" />
        </Button>
        <Button href="/#cultos" variant="ghost">
          {t.cultos}
        </Button>
      </div>
    </div>
  </div>
</BaseLayout>
