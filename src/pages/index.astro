---
// Página provisória (F1): vitrine de tokens e fontes. Substituída pela home na F2/F3.
import BaseLayout from '@/layouts/BaseLayout.astro';
import tokens from '@/design/tokens.json';
import { getIgreja } from '@/lib/igreja';

const igreja = await getIgreja();
const cores = Object.entries(tokens.color);
---

<BaseLayout title="Em construção">
  <section class="bg-night py-20 text-cream">
    <div class="container-site">
      <p class="eyebrow text-blush">Graça e Paz!</p>
      <h1 class="mt-3 text-5xl font-semibold md:text-7xl">{igreja.nome}</h1>
      <p class="mt-4 max-w-xl text-lg text-blush-100">{igreja.slogan}</p>
    </div>
  </section>
  <section class="container-site py-16">
    <h2 class="text-3xl">Paleta</h2>
    <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {cores.map(([nome, hex]) => (
        <li class="overflow-hidden rounded-lg border border-sand bg-white">
          <div class="h-16" style={`background:${hex}`} />
          <p class="px-3 py-2 text-sm">
            <strong>{nome}</strong> <span class="text-muted">{hex}</span>
          </p>
        </li>
      ))}
    </ul>
    <h2 class="mt-12 text-3xl">Tipografia</h2>
    <p class="mt-4 font-display text-4xl font-light italic">Transformando vidas</p>
    <p class="mt-2 max-w-prose">Manrope para textos corridos e interface. {igreja.bio}</p>
    <p class="eyebrow mt-4 text-red-700">Caixa alta espaçada</p>
  </section>
</BaseLayout>
