---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/sections/Header.astro';
import Hero from '@/components/sections/Hero.astro';
import Alianca from '@/components/sections/Alianca.astro';
import QuemSomos from '@/components/sections/QuemSomos.astro';
import Historia from '@/components/sections/Historia.astro';
import Cultos from '@/components/sections/Cultos.astro';
import Visite from '@/components/sections/Visite.astro';
import Assista from '@/components/sections/Assista.astro';
import Cresca from '@/components/sections/Cresca.astro';
import Agenda from '@/components/sections/Agenda.astro';
import Galeria from '@/components/sections/Galeria.astro';
import Contribua from '@/components/sections/Contribua.astro';
import FaleConosco from '@/components/sections/FaleConosco.astro';
import Rodape from '@/components/sections/Rodape.astro';
---

<BaseLayout>
  <Header slot="header" aguardaHero />
  <Hero />
  <Alianca />
  <QuemSomos />
  <Historia />
  <Cultos />
  <Visite />
  <Assista />
  <Cresca />
  <Agenda />
  <Galeria />
  <Contribua />
  <FaleConosco />
  <Rodape slot="footer" />
</BaseLayout>
