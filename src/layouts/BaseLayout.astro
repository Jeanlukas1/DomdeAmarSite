---
import '@/styles/global.css';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import manropeUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { getIgreja, getPrincipal } from '@/lib/igreja';
import { jsonLdIgreja } from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const igreja = await getIgreja();
const ui = await getPrincipal('ui');
const {
  title,
  description = `${igreja.nome} — ${ui.seo.igrejaEm} ${igreja.endereco.bairro}, ${igreja.endereco.cidade} – ${igreja.endereco.uf}. ${igreja.slogan}.`,
  image = '/og-image.jpg',
} = Astro.props;

const fullTitle = title
  ? `${title} | ${igreja.nome}`
  : `${igreja.nome} | ${ui.seo.tituloIgrejaEm} ${igreja.endereco.bairro}, ${igreja.endereco.cidade}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = await jsonLdIgreja(Astro.site!);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeUrl} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#6f0101" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={igreja.nome} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={igreja.nome} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // `js`: há JavaScript (conteúdo que só faz sentido calculado, ex.: a Ceia na semana dela).
      document.documentElement.classList.add('js');
      // Esconde elementos animáveis só se o JS de animação for rodar. Se o init (ou, na home,
      // o hero) não confirmar em 3s, desiste da animação e mostra tudo — nada fica invisível.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-anim');
        setTimeout(function () {
          const heroPendente = document.querySelector('[data-hero-seal]') && !window.__heroReady;
          if (!window.__animReady || heroPendente)
            document.documentElement.classList.remove('js-anim');
        }, 3000);
      }
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-dvh antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-2"
    >
      {ui.a11y.pularConteudo}
    </a>
    <slot name="header" />
    <main id="conteudo">
      <slot />
    </main>
    <slot name="footer" />
    <script>
      // GSAP/Lenis só depois da primeira pintura (protege o LCP)
      import { depoisDaPintura } from '@/lib/agendar';
      depoisDaPintura(() => import('@/lib/animations/init'));
    </script>
  </body>
</html>
