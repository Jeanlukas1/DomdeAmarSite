---
// Vídeo em destaque da seção Assista (docs/secoes/assista.md). Só a foto-pôster carrega antes do
// clique. YouTube: o player (no-cookie) entra no clique. Facebook: abre o vídeo numa aba nova.
// Sem vídeo: o estado "em breve", com link para a página da igreja no Facebook.
// Um link [data-tocar-youtube] em qualquer lugar da página toca aquele vídeo aqui (a lista).
import Foto from '@/components/ui/Foto.astro';
import Icon from '@/components/ui/Icon.astro';
import { idDoYoutube, type Video } from '@/lib/video';

interface FotoRef {
  id: string;
  alt: string;
  posicao: string;
}
interface Props {
  titulo: string;
  /** data · texto bíblico · pregador; null no estado "em breve" */
  linha: string | null;
  video: Video | null;
  poster: FotoRef;
  rotuloAssistir: string;
  emBreve: string;
  rotuloFacebook: string;
  rotuloNovaAba: string;
  /** página da igreja no Facebook (estado "em breve") */
  facebook: string;
}

const {
  titulo,
  linha,
  video,
  poster,
  rotuloAssistir,
  emBreve,
  rotuloFacebook,
  rotuloNovaAba,
  facebook,
} = Astro.props;
const youtube = video?.plataforma === 'youtube' ? idDoYoutube(video.endereco) : null;
const linkFacebook = video?.plataforma === 'facebook' ? video.endereco : video ? null : facebook;
---

<div
  data-video
  data-youtube={youtube ?? undefined}
  data-titulo={titulo}
  class="video relative isolate aspect-[4/5] overflow-hidden rounded-[2rem] bg-wine-950 sm:aspect-video"
>
  <div data-video-poster class="absolute inset-0 -z-10">
    <Foto {...poster} sizes="(min-width: 1280px) 1200px, 100vw" />
    <!-- as fotos dos cultos têm parede branca e lâmpadas no teto: o tom vinho (multiply) segura
         os brancos estourados e o topo escurece onde ficam as luzes -->
    <div class="absolute inset-0 bg-wine-900/45 mix-blend-multiply"></div>
    <div class="absolute inset-x-0 top-0 h-2/5 bg-[linear-gradient(to_bottom,color-mix(in_srgb,var(--color-night)_70%,transparent),transparent)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_top,color-mix(in_srgb,var(--color-night)_96%,transparent)_15%,color-mix(in_srgb,var(--color-night)_55%,transparent)_45%,color-mix(in_srgb,var(--color-night)_10%,transparent)_75%,transparent)]"></div>
  </div>

  <div class="flex h-full flex-col justify-end gap-5 p-6 sm:flex-row sm:items-end sm:justify-between sm:p-10">
    <div class="max-w-xl">
      <h3 class="font-display text-[clamp(1.75rem,3.4vw,2.75rem)] leading-tight text-cream">
        {titulo}
      </h3>
      <p class="mt-2 text-blush-100">{linha ?? emBreve}</p>
    </div>
    {youtube ? (
      <button
        type="button"
        data-video-play
        class="group flex shrink-0 items-center gap-3 self-start rounded-full bg-red-600 py-2 pr-6 pl-2 font-semibold text-white transition-colors duration-base hover:bg-red-500 sm:self-auto"
      >
        <span class="grid size-11 place-items-center rounded-full bg-white text-red-600 transition-transform duration-base group-hover:scale-110">
          <svg viewBox="0 0 24 24" class="ml-0.5 size-5 fill-current" aria-hidden="true">
            <path d="M8 5.5v13l11-6.5z" />
          </svg>
        </span>
        {rotuloAssistir}
        <span class="sr-only">: {titulo}</span>
      </button>
    ) : (
      linkFacebook && (
        <a
          href={linkFacebook}
          target="_blank"
          rel="noopener"
          class="group flex shrink-0 items-center gap-3 self-start rounded-full bg-cream py-2 pr-6 pl-2 font-semibold text-wine-900 transition-colors duration-base hover:bg-white sm:self-auto"
        >
          <span class="grid size-11 place-items-center rounded-full bg-wine-900 text-cream">
            <Icon name="facebook" />
          </span>
          {rotuloFacebook}
          <span class="sr-only">
            {video && `: ${titulo}`} {rotuloNovaAba}
          </span>
        </a>
      )
    )}
  </div>
</div>

<script>
  import { reduceMotion } from '@/lib/agendar';
  import { rolarAte } from '@/lib/rolagem';

  /** Troca o conteúdo do destaque pelo player do YouTube e leva o foco para ele. */
  function tocar(box: HTMLElement, id: string, titulo: string) {
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    iframe.title = titulo;
    iframe.allow =
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.className = 'absolute inset-0 h-full w-full';
    box.replaceChildren(iframe);
    iframe.focus({ preventScroll: true });
  }

  const box = document.querySelector<HTMLElement>('[data-video]');
  if (box) {
    box.querySelector('[data-video-play]')?.addEventListener('click', () => {
      tocar(box, box.dataset.youtube!, box.dataset.titulo ?? '');
    });

    // um culto gravado do YouTube na lista toca aqui, no lugar do destaque
    document.querySelectorAll<HTMLAnchorElement>('a[data-tocar-youtube]').forEach((link) => {
      link.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        tocar(box, link.dataset.tocarYoutube!, link.dataset.titulo ?? '');
        rolarAte(box, { suave: !reduceMotion() });
      });
    });
  }
</script>
