---
// Fale com a gente: pedido de oração e "quero fazer parte". Cada assunto abre o WhatsApp com a
// mensagem já escrita (sem formulário, sem dados guardados no site). Enquanto o número for mock,
// os botões levam ao Facebook da igreja, com um aviso honesto.
import Icon from '@/components/ui/Icon.astro';
import SecaoTitulo from '@/components/ui/SecaoTitulo.astro';
import { getIgreja, getPrincipal, getWhatsapp } from '@/lib/igreja';

const f = await getPrincipal('faleConosco');
const igreja = await getIgreja();
const assuntos = await Promise.all(
  f.assuntos.map(async (a) => ({ ...a, whatsapp: await getWhatsapp(a.mensagem) })),
);
const temWhatsapp = assuntos.every((a) => a.whatsapp);
---

<section
  id="fale"
  aria-labelledby="fale-titulo"
  class="scroll-mt-20 bg-cream py-[clamp(5rem,11vw,9rem)]"
>
  <div class="container-site grid gap-12 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-16 [&>*]:min-w-0">
    <div>
      <SecaoTitulo id="fale-titulo" titulo={f.titulo} destaque={f.destaque}>
        <p>{f.texto}</p>
      </SecaoTitulo>
      {!temWhatsapp && (
        <p class="mt-6 flex max-w-md gap-2 text-sm leading-relaxed text-muted">
          <Icon name="whatsapp" size={18} class="mt-0.5 shrink-0" />
          {f.semWhatsapp.aviso}
        </p>
      )}
    </div>

    <ul class="border-y border-sand" data-reveal-group>
      {assuntos.map((a) => (
        <li id={a.id} class="scroll-mt-28 border-sand py-8 not-first:border-t sm:py-10" data-reveal>
          <h3 class="font-display text-[clamp(1.6rem,3vw,2.2rem)] leading-tight text-ink">
            {a.titulo}
          </h3>
          <p class="mt-3 max-w-xl leading-relaxed text-ink-soft">{a.texto}</p>
          <a
            href={a.whatsapp ?? igreja.redes.facebook}
            target="_blank"
            rel="noopener"
            class="group mt-6 inline-flex min-h-12 items-center gap-3 rounded-full bg-wine-900 py-2 pr-6 pl-2 font-semibold text-cream transition-colors duration-base hover:bg-wine-800"
          >
            <span class="grid size-9 place-items-center rounded-full bg-cream text-wine-900">
              <Icon name={a.whatsapp ? 'whatsapp' : 'facebook'} size={18} />
            </span>
            {a.whatsapp ? a.rotulo : f.semWhatsapp.rotulo}
            <span class="sr-only">: {a.titulo}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
