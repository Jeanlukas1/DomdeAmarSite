---
// Cresça na fé: o Estudo da Palavra como porta de entrada + faixa de ministérios com fotos
// verticais (rolagem nativa; parallax interno ao deslizar).
import Faixa from '@/components/islands/Faixa.astro';
import Button from '@/components/ui/Button.astro';
import Foto from '@/components/ui/Foto.astro';
import Icon from '@/components/ui/Icon.astro';
import SecaoTitulo from '@/components/ui/SecaoTitulo.astro';
import { getOrdenados, getPrincipal } from '@/lib/igreja';

const c = await getPrincipal('cresca');
const ministerios = await getOrdenados('ministerios');
---

<section
  id="cresca"
  aria-labelledby="cresca-titulo"
  class="scroll-mt-20 overflow-hidden bg-sand py-[clamp(5rem,11vw,9rem)]"
>
  <div class="container-site grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.7fr)] lg:items-center lg:gap-16 [&>*]:min-w-0">
    <div>
      <SecaoTitulo id="cresca-titulo" titulo={c.titulo} destaque={c.destaque}>
        <p>{c.texto}</p>
      </SecaoTitulo>

      <div
        class="superficie-escura mt-10 rounded-[1.5rem] bg-wine-900 p-6 text-cream sm:p-8"
        data-reveal="scale"
      >
        <h3 class="font-display text-3xl">{c.primeiroDomingo.titulo}</h3>
        <ol class="mt-5 space-y-4">
          {c.primeiroDomingo.passos.map((passo) => (
            <li class="grid grid-cols-[auto_1fr] gap-3 leading-relaxed text-blush-100">
              <svg viewBox="0 0 24 24" class="mt-1.5 size-3.5 fill-red-500" aria-hidden="true">
                <path d="M12 21s-8-5-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6-8 11-8 11z" />
              </svg>
              <span>{passo}</span>
            </li>
          ))}
        </ol>
      </div>

      <Button href={c.participar.href} class="mt-8">
        {c.participar.rotulo}
        <Icon name="arrow" class="transition-transform duration-base group-hover:translate-x-1" />
      </Button>
    </div>

    <div class="-mx-[clamp(1rem,4vw,2.5rem)] [--faixa-respiro:clamp(1rem,4vw,2.5rem)] lg:mx-0 lg:[--faixa-respiro:0px]">
      <Faixa
        rotulo={c.rotuloLista}
        rotuloAnterior={c.rotuloAnterior}
        rotuloProximo={c.rotuloProximo}
        parallax
        class="[&_[data-faixa-controles]]:px-[var(--faixa-respiro)]"
      >
        {ministerios.map((m) => (
          <li class="w-[72vw] max-w-[19rem] shrink-0 snap-start sm:w-[17rem] lg:w-[clamp(17rem,24vw,21rem)] lg:max-w-none">
            <figure class="relative aspect-[3/4] overflow-hidden lg:aspect-[2/3] rounded-[1.5rem] bg-wine-950">
              <div data-faixa-parallax class="absolute inset-0">
                <Foto
                  {...m.foto}
                  sizes="(min-width: 1024px) 21rem, (min-width: 640px) 17rem, 72vw"
                />
              </div>
              <div class="absolute inset-0 bg-[linear-gradient(to_top,color-mix(in_srgb,var(--color-night)_88%,transparent)_10%,transparent_55%)]" />
              <figcaption class="absolute inset-x-0 bottom-0 p-5 text-cream">
                <h3 class="font-display text-2xl">{m.nome}</h3>
                <p class="mt-1 text-sm leading-snug text-blush-100/85">{m.frase}</p>
              </figcaption>
            </figure>
          </li>
        ))}
      </Faixa>
    </div>
  </div>
</section>
