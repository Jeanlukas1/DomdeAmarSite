---
// Rodapé: o versículo que dá nome à igreja ("é dom de Deus"), endereço, cultos, navegação e redes.
import logoUrl from '@/assets/logo/logo.svg?url';
import Icon from '@/components/ui/Icon.astro';
import { getIgreja, getNavegacao, getRedes, getOrdenados, getPrincipal } from '@/lib/igreja';

const r = await getPrincipal('rodape');
const igreja = await getIgreja();
const nav = await getNavegacao();
const cultos = await getOrdenados('cultos');
const { rua, bairro, cidade, uf, cep } = igreja.endereco;
const enderecoCompleto = `${rua}, ${bairro}, ${cidade} - ${uf}, ${cep}`;
const mapa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(enderecoCompleto)}`;
const horaCurta = (hora: string) => hora.replace(/^0/, '').replace(':00', 'h').replace(':', 'h');
const redes = await getRedes();
const ano = new Date().getFullYear();
---

<footer class="rodape superficie-escura relative overflow-hidden bg-night text-blush-100/80">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-[60%] bg-[radial-gradient(ellipse_60%_80%_at_50%_0%,color-mix(in_srgb,var(--color-wine-900)_70%,transparent),transparent_70%)]"
  ></div>

  <div class="container-site relative pt-[clamp(5rem,10vw,8rem)]">
    <!-- versículo -->
    <figure class="mx-auto max-w-3xl text-center" data-reveal>
      <a
        href="/#inicio"
        class="group mx-auto block w-fit"
        aria-label={`${igreja.nome}: voltar ao início`}
      >
        <img
          src={logoUrl}
          alt=""
          width="88"
          height="88"
          loading="lazy"
          class="size-22 rounded-full ring-1 ring-white/15 transition-transform duration-500 ease-out group-hover:scale-105"
        />
      </a>
      <blockquote class="mt-10 font-display text-[clamp(1.6rem,3.4vw,2.6rem)] leading-snug font-light text-cream italic">
        “{r.versiculo.texto}”
      </blockquote>
      <figcaption class="mt-5 flex items-center justify-center gap-3 text-sm font-semibold text-blush">
        <span class="h-px w-10 bg-current opacity-60"></span>
        <span class="rodape__coracao inline-block text-red-500" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="size-3.5 fill-current">
            <path d="M12 21s-8-5-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6-8 11-8 11z"></path>
          </svg>
        </span>
        {r.versiculo.referencia}
        <span class="h-px w-10 bg-current opacity-60"></span>
      </figcaption>
    </figure>

    <!-- informações -->
    <div class="mt-[clamp(4rem,8vw,6rem)] grid gap-10 border-t border-white/10 pt-12 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <p class="font-display text-2xl text-cream">{igreja.nome}</p>
        <p class="mt-2 max-w-xs">{igreja.slogan}</p>
      </div>

      <address class="not-italic">
        <h2 class="font-display text-lg text-cream">{r.enderecoTitulo}</h2>
        <p class="mt-3 leading-relaxed">
          {rua}
          <br />
          {bairro}, {cidade} – {uf}
          <br />
          CEP {cep}
        </p>
        {igreja.endereco.referencia && (
          <p class="mt-2 text-sm font-semibold text-blush-100">{igreja.endereco.referencia}</p>
        )}
        <a
          href={mapa}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-flex min-h-11 items-center gap-2 font-semibold text-cream underline decoration-white/30 hover:decoration-current"
        >
          {r.mapaRotulo}
          <Icon name="arrow" size={16} />
        </a>
      </address>

      <div>
        <h2 class="font-display text-lg text-cream">{r.cultosTitulo}</h2>
        <ul class="mt-3 space-y-2">
          {cultos.map((c) => (
            <li>
              <span class="text-cream">
                {c.dia}, {horaCurta(c.hora)}
              </span>
              <span class="block text-sm">{c.nome}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="grid gap-10 sm:col-span-2 sm:grid-cols-2 lg:col-span-1 lg:grid-cols-1">
        <nav aria-label="Rodapé">
          <h2 class="font-display text-lg text-cream">{r.navTitulo}</h2>
          <ul class="mt-3 grid grid-cols-2 gap-x-4 lg:grid-cols-1">
            {nav.map((item) => (
              <li>
                <a href={item.href} class="inline-flex min-h-9 items-center hover:text-cream">
                  {item.rotulo}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div>
          <h2 class="font-display text-lg text-cream">{r.redesTitulo}</h2>
          <ul class="mt-3 flex gap-2">
            {redes.map((rd) => (
              <li>
                <a
                  href={rd.href}
                  target="_blank"
                  rel="noopener"
                  class="grid size-11 place-items-center rounded-full bg-white/8 text-cream transition-colors duration-base hover:bg-red-600"
                >
                  <Icon name={rd.icon} label={rd.nome} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <p class="mt-14 border-t border-white/10 py-8 text-sm text-blush-100/60">
      © {ano} {igreja.nome}. {r.direitos}
    </p>
  </div>
</footer>

<style>
  /* o mini-coração bate quando o visitante passa pelo selo ou pelo versículo */
  .rodape:has(figure:hover) .rodape__coracao {
    animation: batida 1.1s var(--ease-out) infinite;
  }
  @keyframes batida {
    0%,
    40%,
    100% {
      transform: scale(1);
    }
    12% {
      transform: scale(1.35);
    }
    26% {
      transform: scale(1.15);
    }
  }
</style>
