---
// Cultos + destaque da semana. Os três encontros como um convite impresso; o próximo culto é
// marcado no navegador (fuso de São Paulo) — sem JS, o convite aparece completo, sem destaque.
import Button from '@/components/ui/Button.astro';
import Foto from '@/components/ui/Foto.astro';
import Icon from '@/components/ui/Icon.astro';
import Ornamento from '@/components/ui/Ornamento.astro';
import SecaoTitulo from '@/components/ui/SecaoTitulo.astro';
import { getOrdenados, getPrincipal } from '@/lib/igreja';

const s = await getPrincipal('cultosSecao');
const cultos = await getOrdenados('cultos');
// "09:00" → "9h", "19:30" → "19h30"
const horaCurta = (hora: string) => hora.replace(/^0/, '').replace(':00', 'h').replace(':', 'h');
---

<section
  id="cultos"
  aria-labelledby="cultos-titulo"
  class="scroll-mt-20 bg-cream py-[clamp(5rem,11vw,9rem)]"
>
  <div class="container-site">
    <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-8">
      <SecaoTitulo id="cultos-titulo" titulo={s.titulo} destaque={s.destaque}>
        <p>{s.texto}</p>
      </SecaoTitulo>
      <Button
        href={s.comoChegar.href}
        variant="ghost"
        class="text-wine-900"
        target="_blank"
        rel="noopener"
      >
        {s.comoChegar.rotulo}
        <Icon name="arrow" class="transition-transform duration-base group-hover:translate-x-1" />
      </Button>
    </div>

    <!-- o convite -->
    <ol
      data-cultos
      data-quando-agora={s.quando.agora}
      data-quando-hoje={s.quando.hoje}
      data-quando-amanha={s.quando.amanha}
      data-reveal-group
      class="mt-14 grid overflow-hidden rounded-[2rem] border border-sand bg-white shadow-[0_40px_80px_-50px_color-mix(in_srgb,var(--color-wine-900)_45%,transparent)] md:grid-cols-3"
    >
      {cultos.map((c) => (
        <li
          data-culto={c.id}
          data-dia={c.diaSemana}
          data-hora={c.hora}
          data-reveal
          class="culto group relative flex flex-col border-sand p-6 transition-colors duration-[600ms] ease-out not-first:border-t sm:p-8 md:not-first:border-t-0 md:not-first:border-l"
        >
          <div class="aspect-[16/10] overflow-hidden rounded-[1.25rem] bg-sand">
            <Foto {...c.foto} sizes="(min-width: 768px) 30vw, 90vw" />
          </div>
          <p class="culto__proximo mt-6 hidden items-center gap-2 text-sm font-semibold text-blush">
            <span class="culto__pulso relative grid size-3 place-items-center">
              <span class="absolute inset-0 rounded-full bg-red-500" />
              <span class="absolute inset-0 rounded-full bg-red-500" />
            </span>
            <span data-quando>{s.proximoRotulo}</span>
          </p>
          <h3 class="culto__titulo mt-6">
            <span class="block font-display text-[clamp(2.4rem,4vw,3.4rem)] leading-none font-normal">
              {c.dia}
            </span>
            <span class="mt-2 block font-display text-xl font-semibold">
              <span class="sr-only">às </span>
              <time
                datetime={c.hora}
                class="text-red-700 tabular-nums group-data-[proximo]:text-blush"
              >
                {horaCurta(c.hora)}
              </time>
              <span aria-hidden="true"> · </span>
              {c.nome}
            </span>
          </h3>
          <p class="mt-3 leading-relaxed text-ink-soft group-data-[proximo]:text-blush-100/85">
            {c.descricao}
          </p>
        </li>
      ))}
    </ol>

    <!-- destaque da semana -->
    <aside
      aria-label={s.semana.rotulo}
      class="mt-10 flex flex-col gap-6 rounded-[2rem] border border-sand px-6 py-8 sm:px-10 md:flex-row md:items-center md:gap-10"
      data-reveal
    >
      <Ornamento class="shrink-0" />
      <div class="min-w-0 flex-1">
        <p class="text-sm font-semibold text-red-700">
          {s.semana.rotulo} · {s.semana.culto}
        </p>
        <p class="mt-2 font-display text-[clamp(1.5rem,2.6vw,2.1rem)] leading-tight text-ink">
          {s.semana.tema}
        </p>
      </div>
      <dl class="grid shrink-0 grid-cols-2 gap-x-8 gap-y-1 text-sm md:block md:text-right">
        {s.semana.referencia && (
          <div>
            <dt class="sr-only">Texto bíblico</dt>
            <dd class="font-semibold text-ink">{s.semana.referencia}</dd>
          </div>
        )}
        <div>
          <dt class="sr-only">Pregador</dt>
          <dd class="text-muted md:mt-1">{s.semana.pregador}</dd>
        </div>
      </dl>
    </aside>
  </div>
</section>

<style>
  .culto[data-proximo] {
    background: var(--color-wine-900);
    color: var(--color-cream);
  }
  .culto[data-proximo] .culto__proximo {
    display: flex;
  }
  .culto[data-proximo] .culto__titulo {
    margin-top: 0.75rem;
  }
  /* batida dupla, como o coração do selo */
  .culto__pulso > span:last-child {
    animation: pulso 1.6s var(--ease-out) infinite;
  }
  @keyframes pulso {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
</style>

<script>
  import { proximoCulto } from '@/lib/proximoCulto';

  const lista = document.querySelector<HTMLElement>('[data-cultos]');
  if (lista) {
    const itens = [...lista.querySelectorAll<HTMLElement>('[data-culto]')];
    const r = proximoCulto(
      itens.map((el) => ({
        id: el.dataset.culto!,
        diaSemana: Number(el.dataset.dia),
        hora: el.dataset.hora!,
      })),
    );
    const alvo = r && itens.find((el) => el.dataset.culto === r.culto.id);
    if (r && alvo) {
      alvo.toggleAttribute('data-proximo', true);
      alvo.setAttribute('aria-current', 'true');
      const rotulo = alvo.querySelector<HTMLElement>('[data-quando]');
      const texto = {
        agora: lista.dataset.quandoAgora,
        hoje: lista.dataset.quandoHoje,
        amanha: lista.dataset.quandoAmanha,
        semana: '',
      }[r.quando];
      if (rotulo && texto) rotulo.textContent = `${rotulo.textContent} · ${texto}`;
    }
  }
</script>
