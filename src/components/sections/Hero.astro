---
import logoRaw from '@/assets/logo/logo.svg?raw';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { getHero, getIgreja, getOrdenados, getPrincipal } from '@/lib/igreja';
import { gradeSemanal, horaCurta } from '@/lib/encontros';

const hero = await getHero();
const igreja = await getIgreja();
const cultos = await getOrdenados('cultos');
const ui = await getPrincipal('ui');
// sem JS: a grade semanal, sempre verdadeira ("Terça 19h · Domingo 9h e 18h"). O navegador troca
// pelo próximo encontro de fato (com a Ceia no 1º domingo) — ver src/lib/encontros.ts.
const grade = gradeSemanal(cultos, ui.diasSemana, ui.a11y.e);
const encontros = cultos.map(
  ({ id, diaSemana, hora, ocorrencia, substituiODia, duracaoMin, recebeTema, nomeCurto }) => ({
    id,
    diaSemana,
    hora,
    ocorrencia,
    substituiODia,
    duracaoMin,
    recebeTema,
    rotulo: `${ui.diasSemana[diaSemana]}, ${horaCurta(hora)}${nomeCurto ? ` · ${nomeCurto}` : ''}`,
  }),
);
// SVG inline para poder animar cada camada (ids: borda, coracao, fita-esq, fita-dir, nome, dom, de, amar, arco-texto, slogan, mini-coracao)
const logo = logoRaw.replace('<svg ', '<svg class="block h-auto w-full overflow-visible" ');
const PARTICULAS = 14;
---

<section
  id="inicio"
  data-hero
  class="superficie-escura relative isolate flex min-h-[100svh] items-center overflow-hidden bg-night text-cream"
>
  <!-- fundo: brilho vinho + vinheta -->
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_70%_at_70%_40%,var(--color-wine-900)_0%,var(--color-wine-950)_45%,var(--color-night)_80%)] max-lg:bg-[radial-gradient(ellipse_120%_60%_at_50%_25%,var(--color-wine-900)_0%,var(--color-wine-950)_50%,var(--color-night)_85%)]"></div>
    <div class="absolute inset-0 opacity-[.035] [background-image:radial-gradient(var(--color-white)_1px,transparent_1px)] [background-size:3px_3px]"></div>
  </div>

  <div class="container-site grid items-center gap-6 pt-20 pb-16 sm:gap-8 sm:pt-24 sm:pb-20 lg:grid-cols-[1.1fr_1fr] lg:gap-12 lg:pt-28">
    <div class="order-2 text-center lg:order-1 lg:text-left">
      <h1 class="text-[clamp(2.4rem,6.4vw,5.4rem)] font-medium tracking-[-0.02em] [font-variation-settings:'opsz'_144]">
        {hero.titulo}
      </h1>
      <!-- sem fade: no celular este parágrafo é o maior elemento do topo (o LCP), e um
           elemento com opacidade 0 só conta como pintado quando o fade termina -->
      <p class="mx-auto mt-6 max-w-xl text-[clamp(1rem,1.6vw,1.2rem)] text-blush-100/85 lg:mx-0">
        <strong class="font-semibold text-cream">{hero.saudacao}</strong> {hero.texto}
      </p>
      <div
        class="hero-in mt-9 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start"
        style="--d: 0.45s"
      >
        <Button href={hero.ctaPrimario.href}>
          {hero.ctaPrimario.rotulo}
          <Icon name="arrow" class="transition-transform duration-base group-hover:translate-x-1" />
        </Button>
        <Button href={hero.ctaSecundario.href} variant="ghost">
          <Icon name="heart" />
          {hero.ctaSecundario.rotulo}
        </Button>
      </div>
      <!-- "quando e onde" logo no topo: o próximo culto é recalculado no navegador -->
      <a
        href={hero.proximo.href}
        data-hero-proximo={JSON.stringify(encontros)}
        data-rotulo={hero.proximo.rotulo}
        class="hero-in group mt-8 inline-flex items-center gap-3 rounded-full border border-white/15 bg-white/5 py-2 pr-4 pl-2 text-sm text-blush-100 transition-colors duration-base hover:border-white/40 hover:bg-white/10"
        style="--d: 0.6s"
      >
        <span class="grid size-8 shrink-0 place-items-center rounded-full bg-red-600 text-white">
          <Icon name="heart" size={16} />
        </span>
        <span class="text-left leading-snug">
          <span class="font-semibold text-cream">
            <span data-hero-proximo-rotulo>{hero.proximo.rotuloGrade}</span>:{' '}
            <span data-hero-proximo-quando>{grade}</span>
          </span>
          <span class="block text-blush-100/90 sm:inline">
            <span class="hidden sm:inline" aria-hidden="true">
              {' '}
              ·{' '}
            </span>
            {igreja.endereco.referencia}, {igreja.endereco.bairro}
          </span>
        </span>
        <Icon
          name="arrow"
          size={16}
          class="shrink-0 transition-transform duration-base group-hover:translate-x-1"
        />
      </a>
    </div>

    <div class="relative order-1 mx-auto w-[min(64vw,22rem,32svh)] lg:order-2 lg:w-[min(40vw,34rem)]">
      <div
        aria-hidden="true"
        data-hero-glow
        class="absolute inset-[-18%] -z-10 rounded-full bg-[radial-gradient(circle,color-mix(in_srgb,var(--color-red-600)_55%,transparent)_0%,color-mix(in_srgb,var(--color-wine-900)_25%,transparent)_40%,transparent_70%)] will-change-[transform,opacity]"
      ></div>
      <div data-hero-seal class="relative [perspective:900px]">
        <div
          data-hero-tilt
          class="rounded-full shadow-[0_30px_80px_-20px_color-mix(in_srgb,var(--color-night)_75%,transparent)]"
        >
          <Fragment set:html={logo} />
        </div>
      </div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        {Array.from({ length: PARTICULAS }, () => (
          <span
            data-particula
            class="absolute top-1/2 left-1/2 size-1.5 rounded-full bg-blush opacity-0 shadow-[0_0_10px_2px_color-mix(in_srgb,var(--color-blush)_70%,transparent)]"
          />
        ))}
      </div>
    </div>
  </div>

  <a
    href="#conteudo-inicio"
    class="hero-in absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-xs font-semibold tracking-eyebrow text-blush-100/70 uppercase transition-colors hover:text-cream sm:flex"
    style="--d: 1.2s"
  >
    {hero.rolar}
    <Icon name="down" class="cue-drift" />
  </a>
</section>
<div id="conteudo-inicio"></div>

<style>
  /* entrada do texto em CSS (não espera JS, protege o LCP) */
  .hero-in {
    animation: hero-in 0.9s var(--ease-out) var(--d, 0s) both;
  }
  /* seta do "role": desce devagar e some, como uma brasa caindo (sem quique) */
  .cue-drift {
    animation: cue-drift 2.4s var(--ease-out) infinite;
  }
  @keyframes cue-drift {
    0% {
      opacity: 0;
      transform: translateY(-6px);
    }
    35% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  /* camadas do selo começam ocultas só quando a animação vai rodar */
  :global(.js-anim) [data-hero-seal] :global(svg > :not(#fundo)) {
    opacity: 0;
  }
</style>

<script>
  import { depoisDaPintura } from '@/lib/agendar';
  // o texto do hero (LCP) pinta primeiro; o selo (GSAP) carrega e começa no frame seguinte
  depoisDaPintura(() => import('@/lib/animations/hero'));
  import { proximoEncontro, type Encontro } from '@/lib/encontros';
  import { agoraDaPagina } from '@/lib/agoraDaPagina';

  // troca a grade semanal (HTML) pelo próximo encontro de fato, no momento da visita. Roda antes
  // de a linha aparecer (.hero-in entra aos 0,6 s), então não há troca visível.
  const link = document.querySelector<HTMLElement>('[data-hero-proximo]');
  const rotulo = link?.querySelector('[data-hero-proximo-rotulo]');
  const alvo = link?.querySelector('[data-hero-proximo-quando]');
  if (link && rotulo && alvo) {
    const encontros: (Encontro & { rotulo: string })[] = JSON.parse(
      link.dataset.heroProximo ?? '[]',
    );
    const r = proximoEncontro(encontros, agoraDaPagina());
    if (r) {
      rotulo.textContent = link.dataset.rotulo ?? '';
      alvo.textContent = r.vez.encontro.rotulo;
    }
  }
</script>
