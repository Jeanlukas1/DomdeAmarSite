---
import logoUrl from '@/assets/logo/logo.svg?url';
import Icon from '@/components/ui/Icon.astro';
import { getNavegacao, getPrincipal, getRedes } from '@/lib/igreja';

interface Props {
  /** Na home, o selo do hero "voa" até o header; o logo do header só aparece depois. */
  aguardaHero?: boolean;
}

const { aguardaHero = false } = Astro.props;
const nav = await getNavegacao();
const ui = await getPrincipal('ui');
const redes = await getRedes();
---

<header
  data-header
  class="group/header superficie-escura fixed inset-x-0 top-0 z-40 text-cream data-[solid]:[--foco:var(--color-red-600)] transition-[background-color,color,box-shadow] duration-base ease-out data-[solid]:bg-cream/90 data-[solid]:text-ink data-[solid]:shadow-[0_1px_0_color-mix(in_srgb,var(--color-wine-950)_8%,transparent),0_8px_30px_-12px_color-mix(in_srgb,var(--color-wine-950)_25%,transparent)] data-[solid]:backdrop-blur-md"
>
  <div class="container-site flex h-[4.5rem] items-center gap-4">
    <a href="/#inicio" class="flex items-center gap-3">
      <img
        src={logoUrl}
        alt=""
        width="44"
        height="44"
        data-header-logo
        data-aguarda-hero={aguardaHero ? '' : undefined}
        class="size-11 rounded-full ring-2 ring-white/15"
      />
      <span class="leading-tight">
        <span class="block text-xs font-bold tracking-[0.16em] uppercase">{ui.marca.linha1}</span>
        <span class="block font-display text-lg font-semibold">{ui.marca.linha2}</span>
      </span>
    </a>

    <nav aria-label={ui.a11y.navPrincipal} class="ml-auto hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) =>
          item.destaque ? (
            <li class="ml-2">
              <a
                href={item.href}
                class="inline-flex min-h-10 items-center rounded-full bg-red-600 px-5 text-sm font-semibold text-white transition-colors duration-base hover:bg-red-500"
              >
                {item.rotulo}
              </a>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class="relative inline-flex min-h-10 items-center px-3 text-sm font-medium opacity-85 transition-opacity duration-base after:absolute after:inset-x-3 after:bottom-1.5 after:h-0.5 after:origin-left after:scale-x-0 after:rounded-full after:bg-red-600 after:transition-transform after:duration-base hover:opacity-100 hover:after:scale-x-100"
              >
                {item.rotulo}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <ul class="hidden items-center gap-1 xl:flex" aria-label={ui.a11y.redes}>
      {redes.map((r) => (
        <li>
          <a
            href={r.href}
            target="_blank"
            rel="noopener"
            class="grid size-10 place-items-center rounded-full opacity-75 transition-[opacity,background-color] duration-base hover:bg-current/10 hover:opacity-100"
          >
            <Icon name={r.icon} label={r.nome} />
          </a>
        </li>
      ))}
    </ul>

    <button
      type="button"
      data-menu-open
      aria-expanded="false"
      aria-controls="menu-mobile"
      class="ml-auto grid size-11 place-items-center rounded-full transition-colors hover:bg-current/10 lg:hidden"
    >
      <Icon name="menu" size={24} label={ui.a11y.abrirMenu} />
    </button>
  </div>
</header>

<!-- fora do <header>: o backdrop-blur dele prenderia o position:fixed do menu -->
<div
  id="menu-mobile"
  data-menu
  hidden
  class="superficie-escura fixed inset-0 z-50 flex flex-col bg-wine-950 text-cream lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label={ui.a11y.menu}
>
  <div class="container-site flex h-[4.5rem] items-center justify-between">
    <span class="font-display text-lg font-semibold">{ui.marca.linha2}</span>
    <button
      type="button"
      data-menu-close
      class="grid size-11 place-items-center rounded-full hover:bg-white/10"
    >
      <Icon name="close" size={24} label={ui.a11y.fecharMenu} />
    </button>
  </div>
  <nav aria-label={ui.a11y.navCelular} class="container-site flex-1 overflow-y-auto pt-6">
    <ul class="space-y-1">
      {nav.map((item) => (
        <li data-menu-item>
          <a
            href={item.href}
            class:list={[
              'flex items-center justify-between border-b border-white/10 py-4 font-display text-3xl',
              item.destaque && 'text-blush',
            ]}
          >
            {item.rotulo}
            <Icon name="arrow" class="opacity-50" />
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <ul class="container-site flex gap-2 py-8" aria-label={ui.a11y.redes}>
    {redes.map((r) => (
      <li data-menu-item>
        <a
          href={r.href}
          target="_blank"
          rel="noopener"
          class="grid size-12 place-items-center rounded-full bg-white/10"
        >
          <Icon name={r.icon} label={r.nome} />
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  import { getLenis } from '@/lib/animations/smooth';

  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]')!;
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]')!;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const desktop = window.matchMedia('(min-width: 1024px)');

  // fundo sólido depois de rolar um pouco
  const onScroll = () => header.toggleAttribute('data-solid', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  /** Tudo fora do menu fica inerte enquanto ele está aberto: o Tab não escapa do diálogo. */
  function setBackgroundInert(inert: boolean) {
    for (const el of document.body.children) {
      if (el !== menu && el instanceof HTMLElement) el.inert = inert;
    }
  }

  function setOpen(open: boolean, { restoreFocus = true } = {}) {
    if (open === !menu.hidden) return;
    menu.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    setBackgroundInert(open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) getLenis()?.stop();
    else getLenis()?.start();
    if (open) {
      closeBtn.focus();
      if (reduce.matches) return;
      menu.querySelectorAll<HTMLElement>('[data-menu-item]').forEach((el, i) => {
        el.animate(
          [
            { opacity: 0, transform: 'translateY(16px)' },
            { opacity: 1, transform: 'none' },
          ],
          {
            duration: 420,
            delay: 40 * i,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            fill: 'backwards',
          },
        );
      });
    } else if (restoreFocus) openBtn.focus();
  }

  openBtn.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  // ao tocar num link o foco segue para o destino, não volta ao botão
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false, { restoreFocus: false });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  // virou desktop com o menu aberto: fecha e destrava a rolagem
  desktop.addEventListener('change', (e) => {
    if (e.matches) setOpen(false, { restoreFocus: false });
  });
</script>
