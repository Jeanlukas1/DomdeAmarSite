---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'ghost' | 'light';
}

const { href, variant = 'primary', class: className, ...rest } = Astro.props;

const styles = {
  primary: 'bg-red-600 text-white hover:bg-red-500',
  ghost: 'border border-current/30 text-current hover:border-current hover:bg-current/5',
  light: 'bg-cream text-wine-900 hover:bg-white',
};
---

<a
  href={href}
  class:list={[
    'group inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-6 py-3 text-base font-semibold tracking-tight transition-[background-color,transform,border-color] duration-base ease-out active:scale-[.98]',
    styles[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
