{
  "$description": "Fonte única dos tokens de design (site + futuro app). Gera src/styles/tokens.css via `npm run tokens`.",
  "color": {
    "red-500": "#f0141a",
    "red-600": "#de0101",
    "red-700": "#a90504",
    "wine-800": "#8a0303",
    "wine-900": "#6f0101",
    "wine-950": "#2a0505",
    "night": "#140708",
    "blush": "#d08383",
    "blush-100": "#f7e3e1",
    "ink": "#111111",
    "ink-soft": "#3d3536",
    "muted": "#6e6264",
    "cream": "#fff8f3",
    "sand": "#f4ebe4",
    "white": "#ffffff"
  },
  "font": {
    "display": "'Fraunces Variable', 'Iowan Old Style', Georgia, serif",
    "sans": "'Manrope Variable', system-ui, -apple-system, 'Segoe UI', sans-serif"
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.75rem",
    "lg": "1.25rem",
    "xl": "2rem"
  },
  "ease": {
    "out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
  },
  "duration": {
    "fast": "180ms",
    "base": "320ms",
    "reveal": "800ms"
  },
  "tracking": {
    "eyebrow": "0.22em"
  }
}
